legacy-peer-deps=true
# Node 26 defines a global `localStorage` (undefined unless --localstorage-file
# is passed) that shadows jsdom's, breaking any test that calls
# `window.localStorage`. The project targets Node 24.x, where that global does
# not exist. This keeps `npm test` green on Node 26 as well.
node-options=--no-experimental-webstorage
