# ============================================
# COALITION AI SERVER CONFIGURATION
# ============================================
# Server-side only. Do not prefix these with VITE_.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
FULL_AI_PASSWORD=YOUR_FULL_AI_PASSWORD_HERE
