# Production Environment Variables Template
# Copy this file to create your production .env

# ============================================
# STRIPE — the site checkout (primary)
# ============================================
# Publishable key. It is public by design and MUST carry the VITE_ prefix so
# Vite can inline it into the client bundle.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE
# Server-side only. Never prefix these with VITE_: every VITE_ value is
# compiled into the public browser bundle.
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY_HERE
# The endpoint secret Stripe signs webhook deliveries with.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ============================================
# WHOP — the promoter channel (links only, not the site checkout)
# ============================================
# Get your API key from: https://dashboard.whop.com/api-keys
WHOP_API_KEY=whop_YOUR_LIVE_WHOP_API_KEY_HERE
WHOP_WEBHOOK_SECRET=ws_YOUR_WHOP_WEBHOOK_SECRET_HERE
# The company id a checkout configuration is created under (biz_...).
WHOP_ACCOUNT_ID=biz_YOUR_COMPANY_ID
# Optional: JSON map of site product id -> Whop product id, e.g.
# {"prod_tee_above_as_below": "prod_xxxx"}
WHOP_PRODUCT_MAP=
# Optional: used when the map has no entry for the product.
WHOP_DEFAULT_PRODUCT_ID=
# Optional: default promoter/affiliate code when a request omits one.
WHOP_AFFILIATE_CODE=
# Optional: where Whop sends the buyer after purchase.
WHOP_REDIRECT_URL=

