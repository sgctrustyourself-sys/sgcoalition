# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
# The sending domain is mail.sgcoalition.xyz (verified in Resend). Until it is
# set, Resend only delivers to the account owner's address, so fall back to
# onboarding@resend.dev.
RESEND_FROM_EMAIL="SG Coalition <onboarding@resend.dev>"
# Comma-separate multiple recipients if needed.
ORDER_NOTIFICATION_EMAIL=sgctrustyourself@gmail.com

# ============================================
# DISCORD OAUTH (not wired)
# ============================================
# No code reads a Discord OAuth credential today. If it is ever wired, keep the
# client id public (VITE_DISCORD_CLIENT_ID) and the client secret server-side
# (DISCORD_CLIENT_SECRET, no VITE_ prefix) — a VITE_ secret is shipped to every
# browser.

# ============================================
# NOTES
# ============================================
# 1. NEVER commit this file to Git with real values
# 2. Add these variables to Vercel Dashboard instead
# 3. For local development, use .env.local
# 4. Test mode keys start with pk_test_ and sk_test_
# 5. Live mode keys start with pk_live_ and sk_live_

# --- Shippo shipping-label automation (services/shipping.ts) ---
# Buys the cheapest USPS Ground Advantage label when the Stripe webhook
# confirms payment. SHIP_FROM_* is the pickup address the labels ship from;
# the street address and phone stay in Vercel env vars only, never committed.
SHIPPO_API_TOKEN=shippo_live_YOUR_TOKEN_HERE
SHIP_FROM_NAME=SGCoalition
SHIP_FROM_STREET1=YOUR_PICKUP_STREET_ADDRESS
SHIP_FROM_CITY=York
SHIP_FROM_STATE=PA
SHIP_FROM_ZIP=17404
SHIP_FROM_PHONE=YOUR_PICKUP_PHONE

# --- Shippo tracking webhooks (api/shippo-webhook.ts) ---
# Shippo POSTs tracking-status updates (first scan, delivered) to
# https://sgcoalition-five.vercel.app/api/shippo-webhook?token=<value>. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SHIPPO_WEBHOOK_TOKEN=YOUR_RANDOM_48_CHAR_HEX