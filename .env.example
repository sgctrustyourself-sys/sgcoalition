# =============================================================================
# SG Coalition — environment variable template
# =============================================================================
# This file lists every env var the codebase reads (Vercel + Supabase + Twilio
# + Resend + PayPal + Stripe + Alchemy + Polygon + admin tokens). Copy to
# `.env.local` (gitignored) for local dev, or paste into Vercel Project
# Settings > Environment Variables for Production / Preview / Development.
#
# All values are PLACEHOLDERS — replace before running. Items marked
# `[build]` are VITE_-prefixed and must be present at `vite build` time;
# the rest are runtime-only and can be rotated in Vercel without a rebuild.
# Items marked `[secret]` must NEVER be committed to git and should only
# live in Vercel + a password manager.
# =============================================================================

# ---------- Supabase ----------
# VITE_SUPABASE_URL is the project URL from Supabase > Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY is the anon/public JWT; safe to ship in the
# browser because RLS gates every read.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
# SUPABASE_URL is the same project URL, used by the api/* serverless
# functions so they can connect from Vercel.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. [secret] Server-side only —
# this key is the difference between admin and anon access. Rotate
# immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ---------- Site URL ----------
# VITE_APP_URL is the canonical public origin (used for OAuth redirects,
# PayPal cancel/return URLs, share-link rendering, etc.).
VITE_APP_URL=https://sgcoalition.xyz

# ---------- PayPal ----------
# PAYPAL_ENV selects api-m.sandbox.paypal.com vs api-m.paypal.com.
# Use 'sandbox' for pre-launch testing, 'live' for production.
PAYPAL_ENV=sandbox
# VITE_PAYPAL_CLIENT_ID is [build] — must be present when running
# `npm run build` because the PayPal SDK is loaded with this client ID
# embedded into index.html.
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
# PAYPAL_CLIENT_ID + PAYPAL_CLIENT_SECRET are server-side credentials
# used by api/_handlers/paypal-order.ts. [secret]
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
# PAYPAL_API_BASE_URL is an optional override; if unset the helper
# falls back to api-m.{sandbox.}paypal.com based on PAYPAL_ENV.
# PAYPAL_API_BASE_URL=https://api-m.paypal.com

# ---------- Stripe ----------
# STRIPE_SECRET_KEY is [secret] — the live key, server-side only.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# VITE_STRIPE_PUBLISHABLE_KEY is [build] — the publishable key, safe to
# ship in the browser.
VITE_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
# STRIPE_WEBHOOK_SECRET is [secret] — from the Stripe webhook endpoint
# settings. Required for /api/stripe-webhook signature verification.
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# ---------- Resend (transactional + marketing email) ----------
# RESEND_API_KEY is [secret] — from resend.com/api-keys.
RESEND_API_KEY=YOUR_RESEND_API_KEY
# RESEND_FROM_EMAIL is the verified sender identity. Must be a domain
# you've added to Resend (or onboarding@resend.dev for sandbox).
RESEND_FROM_EMAIL=SG Coalition <orders@sgcoalition.xyz>
# ORDER_NOTIFICATION_EMAIL is where the operator gets the PayPal order
# alert. Can be a personal address.
ORDER_NOTIFICATION_EMAIL=sgctrustyourself@gmail.com

# ---------- Twilio (SMS — marketing + verification) ----------
# TWILIO_ACCOUNT_SID is [secret] — starts with AC.
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN is [secret] — from twilio.com console.
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# TWILIO_FROM_NUMBER is the E.164 number that sends SMS (e.g. +14105550100).
TWILIO_FROM_NUMBER=+15555550100

# ---------- Web3 / SGCoin (Polygon) ----------
# VITE_ALCHEMY_KEY is the Alchemy API key for Polygon RPC reads. [build]
VITE_ALCHEMY_KEY=YOUR_ALCHEMY_KEY
# VITE_POLYGON_RPC_URL is the fallback public RPC if Alchemy is down.
# The default is polygon-rpc.com; override only if you've paid for a
# dedicated provider.
VITE_POLYGON_RPC_URL=https://polygon-rpc.com
# SGC_POLYGONSCAN_API_KEY is the optional Polygonscan key used for
# contract-source verification. [secret] Not required for production
# runtime, only for Etherscan-style source upload.
SGC_POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY
# VITE_SGCOIN_CONTRACT_ADDRESS is the deployed SGCoin ERC-20 on Polygon mainnet.
VITE_SGCOIN_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# ---------- Admin / auth gate ----------
# ADMIN_SESSION_TOKEN is the primary admin Bearer token checked by
# withAdminAuth() in api/_helpers.ts. [secret] Rotate on a coordinated
# cadence with FULL_AI_PASSWORD + AI_SESSION_SECRET — they're checked
# in order in the same gate.
ADMIN_SESSION_TOKEN=YOUR_ADMIN_SESSION_TOKEN
# FULL_AI_PASSWORD is the secondary admin token (legacy). Same
# rotation cadence as ADMIN_SESSION_TOKEN.
FULL_AI_PASSWORD=YOUR_FULL_AI_PASSWORD
# AI_SESSION_SECRET is the tertiary admin token (legacy). Same
# rotation cadence.
AI_SESSION_SECRET=YOUR_AI_SESSION_SECRET
# ADMIN_BROADCAST_TOKEN was a marketing-specific token; it is no
# longer accepted. Leave unset.

# ---------- AI / chat ----------
# GOOGLE_GENERATIVE_AI_API_KEY is the Gemini API key for the in-app
# AI chat widget. [secret] Optional — the chat widget degrades to a
# static FAQ if unset.
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY

# ---------- Rate-limit / feature flags ----------
# DISABLE_RATE_LIMIT=1 turns off the in-memory rate limiter. Only set
# during a load test or a manual operator smoke run. Production
# should NEVER set this.
# DISABLE_RATE_LIMIT=1

# ---------- Sentry (frontend error tracking) ----------
# VITE_SENTRY_DSN is the [build] DSN from the Sentry project settings
# page (Project Settings > SDK Setup > Client Keys). It is [build]
# because Sentry.init() is called with the value baked into the
# shipped JS bundle.
#
# The init (services/sentryInit.ts) is GATED on this var being set
# AND on import.meta.env.PROD. Concretely:
#   - If you forget to set it: no-op, no console warnings, no
#     thrown boot errors. Errors still log via console.error +
#     end up in the Vercel runtime.
#   - DEV / preview builds never initialize even with the DSN
#     set, so a preview deploy cannot accidentally leak events
#     to Sentry's ingest.
# VITE_SENTRY_DSN=https://YOUR_PUBLIC_KEY@oYOUR_ORG_ID.ingest.sentry.io/YOUR_PROJECT_ID
# Optional: tune the sample rate via a redeploy + Vite env override.
# The default in services/sentryInit.ts is 0.1 (10%).

# ---------- Build / runtime ----------
# NODE_ENV is set automatically by Vercel (production / preview /
# development). Don't override.
# NODE_ENV=production
